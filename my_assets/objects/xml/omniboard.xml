<mujoco model="omniboard">
  <asset>
    <!-- Mesh jest autorowany w metrach (krzyz 0.32 x 0.32 x 0.08) -->
    <mesh file="meshes/Omniboard.stl" name="omniboard_mesh" scale="1 1 1"/>
  </asset>

  <worldbody>
    <body>
      <body name="object">
        <!-- Srodek krzyza duzej (tylnej) sciany meshu lezy w (0.16, 0.04281, -0.03281).
             Offset przesuwa go do origin body; bryla zweza sie w +Z (0..0.08):
             duza sciana (montaz do muru) w z=0, mala sciana frontowa w z=0.08,
             ramiona koncza sie skosami 45 deg (na nich siedza przyciski). -->
        <geom name="board_visual" type="mesh" mesh="omniboard_mesh"
              pos="-0.16 -0.04281 0.03281"
              rgba="0.95 0.78 0.05 1" group="1" contype="0" conaffinity="0"/>

        <!-- Kolizja z tego samego mesha (MuJoCo uzywa convex hull — plaszczyzny
             skosow i frontu sa na hullu, wiec przyciski leza dokladnie na nich) -->
        <geom name="board_collision" type="mesh" mesh="omniboard_mesh"
              pos="-0.16 -0.04281 0.03281" group="0"/>
      </body>

      <site rgba="0 0 0 0" size="0.005" pos="0 0 0" name="bottom_site"/>
      <site rgba="0 0 0 0" size="0.005" pos="0 0 0.08" name="top_site"/>
      <site rgba="0 0 0 0" size="0.005" pos="0.16 0.16 0" name="horizontal_radius_site"/>
    </body>
  </worldbody>
</mujoco>
