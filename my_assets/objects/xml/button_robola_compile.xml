<mujoco model="emergency_stop_button">
  <!--robola compile-->
  <compiler angle="radian"/>

  <asset>
    <mesh name="estop_mesh" content_type="model/stl" file="meshes/Emergency stop.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <body>
      <body name="object">
        <geom name="base_visual" size="0.03 0.02" pos="0 0 0.02" type="cylinder" contype="0" conaffinity="0" group="1" rgba="0.95 0.78 0.05 1"/>
        <geom name="base_collision" size="0.03 0.02" pos="0 0 0.02" type="cylinder" contype="2"/>
        <site name="button_force_site" pos="0 0 0.045" rgba="1 0 0 0.5"/>
        <body name="button_cap" pos="0 0 0.04">
          <joint name="button_slide" pos="0 0 0" axis="0 0 -1" type="slide" stiffness="500" range="0 0.015" damping="20" frictionloss="1"/>
          <geom name="cap_visual" type="mesh" contype="0" conaffinity="0" group="1" rgba="1 0.1 0.1 1" mesh="estop_mesh"/>
          <geom name="cap_collision" size="0.022 0.012" type="cylinder" contype="4" friction="0.8 0.01 0.001"/>
          <site name="button_top" pos="0 0 0.013" rgba="1 1 0 0.8"/>
          <site name="button_contact_site" pos="0 0 0.012" size="0.003" rgba="0 0 1 0.5"/>
        </body>
      </body>
    </body>
  </worldbody>

  <sensor>
    <force site="button_contact_site" name="button_force"/>
  </sensor>
</mujoco>
