<mujoco model="emergency_stop_button_lab">
  <!-- Lab E-stop box (ALeRT, measured 2026-10-29): housing 65 x 65 x 50 mm,
       cap top 30 mm above the lid (80 mm above the mounting face).
       Same joint, cap and sites as button.xml; only the heights differ. -->

  <worldbody>
    <body>
      <body name="object">
        <geom name="base_visual" type="box" size="0.0325 0.0325 0.025"
              pos="0 0 0.025" rgba="0.95 0.78 0.05 1" group="1" contype="0" conaffinity="0"/>
        <geom name="base_collision" type="box" size="0.0325 0.0325 0.025"
              pos="0 0 0.025" group="0" contype="2" conaffinity="1"/>

        <site name="button_force_site" pos="0 0 0.072" size="0.005" rgba="1 0 0 0.5"/>

        <body name="button_cap" pos="0 0 0.067">
          <joint name="button_slide" type="slide" axis="0 0 -1"
                 range="0 0.015" stiffness="500" damping="20" frictionloss="1"/>

          <!-- neck from inside the lid to the cap -->
          <geom name="cap_neck_visual" type="cylinder" size="0.014 0.012"
                pos="0 0 -0.020" rgba="0.15 0.15 0.15 1" group="1"
                contype="0" conaffinity="0"/>
          <geom name="cap_visual" type="cylinder" size="0.022 0.012"
                pos="0 0 0" rgba="0.85 0.05 0.05 1" group="1"
                contype="0" conaffinity="0"/>
          <geom name="cap_collision" type="cylinder" size="0.022 0.012"
                pos="0 0 0" group="0" condim="3" friction="0.8 0.01 0.001"
                contype="4" conaffinity="1"/>

          <site name="button_top" pos="0 0 0.013" size="0.005" rgba="1 1 0 0.8"/>
          <site name="button_contact_site" pos="0 0 0.012" size="0.003" rgba="0 0 1 0.5"/>
        </body>
      </body>
    </body>
  </worldbody>

  <sensor>
    <force name="button_force" site="button_contact_site"/>
  </sensor>

</mujoco>
